<Window x:Class="PresentationsLager.Views.MedlemMenyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PresentationsLager.Views"
        xmlns:vm="clr-namespace:PresentationsLager.ViewModels"
        mc:Ignorable="d"
        Title="MedlemMenyWindow" Height="650" Width="300"
        Background="White">

    <Window.DataContext>
        <vm:MedlemMenyViewModel/>
    </Window.DataContext>

    <Window.Resources>

        <!-- Button Style -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#60c3b6"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="BorderBrush" Value="#60c3b6" />
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#60c3b6" />
                    <Setter Property="Foreground" Value="LightGray"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataTemplate för ListView -->
        <DataTemplate x:Key="ListViewItemTemplate">
            <StackPanel Orientation="Vertical" Margin="0,10,0,10">
                <TextBlock FontSize="14" TextWrapping="Wrap" Height="90" Width="175">
                    <Run Text="Distans: " />
                    <Run Text="{Binding Distans}"/>
                    <Run Text=" km" />
                    <LineBreak/>
                    <Run Text="Tempo: " />
                    <Run Text="{Binding Tempo}" FontStyle="Italic" Foreground="LightSlateGray"/>
                    <Run Text="/km" />
                    <LineBreak/>
                    <Run Text="{Binding Plats}" />
                    <LineBreak/>
                    <Run Text="{Binding Beskrivning}" />
                    <LineBreak/>
                    <Run Text="{Binding Datum}" />
                </TextBlock>

                <Button Content="Visa Mer Information"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding DataContext.VisaMerInformationCommand, 
                                          RelativeSource={RelativeSource AncestorType=ListView}}"
                        CommandParameter="{Binding}"/>
            </StackPanel>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="9*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Meny"
            Style="{StaticResource MenuButtonStyle}"
            Command="{Binding MenyKnappCommand}"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Margin="0,10,0,10"/>
                <TextBlock Text="Tillgängliga pass" Foreground="#60c3b6" FontWeight="Bold" FontSize="18" Margin="45,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <ListView x:Name="listView"
                      ItemsSource="{Binding PassLista}"
                      SelectionMode="Single"
                      SelectedItem="{Binding ValdTräningspass, Mode=TwoWay}"
                      ItemTemplate="{StaticResource ListViewItemTemplate}"
                      Width="250" 
                      HorizontalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2">
            <Button Content="Skapa Träningpass"
                Style="{StaticResource MenuButtonStyle}"
                Command="{Binding SkapaTräningspassCommand}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,10,0,10"/>
        </Grid>
    </Grid>

</Window>
