<Window x:Class="PresentationsLager.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PresentationsLager.ViewModels"
        mc:Ignorable="d"
        Title="LoginWindow" Height="650" Width="300"
        Background="white">

    <Window.DataContext>
        <vm:LoginWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#60c3b6"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="BorderBrush" Value="#60c3b6" />
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#60c3b6" />
                    <Setter Property="Foreground" Value="LightGray"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>


    <Grid>


        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,5">

            <TextBlock Text="Logga in" FontSize="24" FontWeight="Bold" TextAlignment="Center" Foreground="#60c3b6"/>
            
            <Image Source="/Bilder/RunWithMeFIGMALIGMA.png" Height="200"></Image>

            <TextBlock Text="Användarnamn:" Foreground="#60c3b6" FontWeight="Bold"/>
            <TextBox Text="{Binding Användarnamn, UpdateSourceTrigger=PropertyChanged}" Width="200" Height="25" />

            <TextBlock Text="Lösenord:" Foreground="#60c3b6"  FontWeight="Bold"/>
            <PasswordBox Width="200" Height="25" PasswordChanged="PasswordBox_PasswordChanged"/>

            <StackPanel Margin="0,10,0,0">
                <Button Content="Logga in" Width="200" Height="25" Command="{Binding LoggaInCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="Tillbaka" Width="200" Height="25" Command="{Binding TillbakaCommand}" Style="{StaticResource MenuButtonStyle}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
