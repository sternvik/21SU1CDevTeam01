<Window x:Class="PresentationsLager.Views.AvbokaPassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PresentationsLager.Views"
        mc:Ignorable="d"
        Title="AvbokaPassWindow" Height="650" Width="300">

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#60c3b6"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="BorderBrush" Value="#60c3b6" />
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#60c3b6" />
                    <Setter Property="Foreground" Value="LightGray"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="9*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid Grid.Row="0">
                <Button Content="Meny"
                    Style="{StaticResource MenuButtonStyle}"
                    Command="{Binding MenyKnappCommand}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="0,10,0,10"/>
            </Grid>
        </Grid>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,5" Grid.Row="1">
            <TextBlock Text="Passinformation" FontWeight="Bold" Foreground="#60c3b6" HorizontalAlignment="Center" FontSize="20"/>
            <TextBlock Text="Plats:" FontWeight="Bold" Foreground="#60c3b6"/>
            <TextBox Text="{Binding ValdTräningspass.Plats, Mode=OneWay}" Height="25" Width="200" IsReadOnly="True" Margin="0,5,0,5"/>

            <TextBlock Text="Distans:" FontWeight="Bold" Foreground="#60c3b6"/>
            <TextBox Text="{Binding ValdTräningspass.Distans, Mode=OneWay}" Height="25" Width="200" IsReadOnly="True" Margin="0,5,0,5"/>

            <TextBlock Text="Tempo:" FontWeight="Bold" Foreground="#60c3b6"/>
            <TextBox Text="{Binding ValdTräningspass.Tempo, Mode=OneWay}" Height="25" Width="200" IsReadOnly="True" Margin="0,5,0,5"/>

            <TextBlock Text="Beskrivning:" FontWeight="Bold" Foreground="#60c3b6"/>
            <TextBox Text="{Binding ValdTräningspass.Beskrivning, Mode=OneWay}" Height="80" Width="200" IsReadOnly="True" Margin="0,5,0,5"/>

            <TextBlock Text="Nuvarande Deltagare" FontWeight="Bold" Foreground="#60c3b6" />
            <ListBox ItemsSource="{Binding Deltagare}" DisplayMemberPath="Namn" Height="100" Width="200" Margin="0,5,0,5"/>

            <Button Content="Avboka pass" Command="{Binding AvanmälTräningspassCommand}" Height="35" Width="200" HorizontalAlignment="Center" Style="{StaticResource MenuButtonStyle}"/>
            <Button Content="Tillbaka"  Command="{Binding TillbakaCommand}" Height="35" Width="200" HorizontalAlignment="Center" Style="{StaticResource MenuButtonStyle}" Margin="0,5,0,5"/>
        </StackPanel>
    </Grid>
</Window>
