<Window x:Class="Presentationslager.RegistreraWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Presentationslager.ViewModels"
        xmlns:Services="clr-namespace:Presentationslager.Services"
        mc:Ignorable="d"
        Title="RegistreraWindow" Height="450" Width="800"
        Background="#6AB">

    <Window.DataContext>
        <vm:RegistreraViewModel/>
    </Window.DataContext>

    <Border Padding="20" BorderBrush="Black" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,5">
            <TextBlock Text="Registrera konto" FontSize="24" FontWeight="Bold" TextAlignment="Center"/>

            <TextBlock Text="Namn:"/>
            <TextBox Width="200" Height="25" Text="{Binding Namn, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Specialisering:"/>
            <ComboBox Width="200" Height="25" ItemsSource="{Binding Specialiseringar}" SelectedItem="{Binding Specialisering}"/>

            <TextBlock Text="Lösenord:"/>
            <PasswordBox Width="200" Height="25" x:Name="LösenordBox" Services:LösenordService.Password="{Binding Lösenord, Mode=TwoWay}"/>

            <TextBlock Text="Bekräfta Lösenord:"/>
            <PasswordBox Width="200" Height="25" x:Name="BekräftaLösenordBox" Services:LösenordService.Password="{Binding BekräftaLösenord, Mode=TwoWay}"/>

            <StackPanel Margin="0,10,0,0">
                <Button Content="Registrera" Width="200" Height="25" Command="{Binding RegistreraCommand}"/>
                <Button Content="Tillbaka" Width="200" Height="25" Command="{Binding TillbakaCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>