<Window x:Class="Presentationslager.Personal.Utlåningshatering.UtlåningshanteringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager.Personal.Utlåningshatering"
        xmlns:vm="clr-namespace:Presentationslager.ViewModels"
        mc:Ignorable="d"
        Title="UtlåningshanteringWindow" Height="450" Width="800"
        Background="#6ab">

    <Window.DataContext>
        <vm:UtlåningshanteringViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Definiera en stil för alla knappar i fönstret och tilldela samma mellanrum (margin) för dem -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Utlåningshantering" FontSize="25" FontWeight="Bold"/>
            <Button Content="Skapa Utlåning" Height="25" Width="200" Command="{Binding ÖppnaSkapaUtlåningCommand}"/>
            <Button Content="Återlämna utlåning" Height="25" Width="200" Command="{Binding ÖppnaÅterlämnaUtlåningCommand}"/>
            <Button Content="Visa alla utlåningar/historik" Height="25" Width="200" Command="{Binding ÖppnaVisaAllaUtlåningarCommand}"/>
            <Button Content="Tillbaka" Height="25" Width="200" Command="{Binding TillbakaCommand}"/>
        </StackPanel>
    </Grid>
</Window>
