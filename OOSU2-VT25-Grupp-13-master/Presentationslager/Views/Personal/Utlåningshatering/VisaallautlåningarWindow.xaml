<Window x:Class="Presentationslager.Personal.Utlåningshatering.VisaallautlåningarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager.Personal.Utlåningshatering"
        xmlns:vm="clr-namespace:Presentationslager.ViewModels"
        mc:Ignorable="d"
        Title="VisaallautlåningarWindow" Height="450" Width="800"
        Background="#6ab">
    <Window.DataContext>
        <vm:VisaAllaUtlåningarViewModel/>
    </Window.DataContext>


    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="9*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <!--Titel-->
        <TextBlock Text="Visa alla utlåningar" FontSize="25" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center"/>

        <Grid Margin="25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Utlåningstatus filter:" FontWeight="Bold" TextAlignment="Center"/>
                <ComboBox ItemsSource="{Binding StatusAlternativ}" Height="25" Width="200" SelectedItem="{Binding ValdStatus, Mode=TwoWay}"/>

                <DataGrid ItemsSource="{Binding AllaUtlåningar}" Width="500" Height="250" SelectedItem="{Binding ValdUtlåning, Mode=TwoWay}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Vald utlåningsinformation" FontWeight="Bold"/>

                <TextBlock Text="Medlem som har lånat:"/>
                <TextBox Text="{Binding ValdMedlem.Namn}" Height="25" Width="200" IsReadOnly="True"/>

                <TextBlock Text="Utlånad utrustning:"/>
                <TextBox Text="{Binding ValdUtrustning.Namn}" Height="25" Width="200" IsReadOnly="True"/>

                <TextBlock Text="Utlåningsdatum:"/>
                <TextBox Text="{Binding Utlåningsdatum}" Height="25" Width="200" IsReadOnly="True"/>

                <TextBlock Text="Återlämningsdatum:"/>
                <TextBox Text="{Binding Återlämningsdatum}" Height="25" Width="200" IsReadOnly="True"/>
            </StackPanel>
        </Grid>

        <Button Content="Tillbaka" Height="25" Width="200" Command="{Binding TillbakaCommand}"  Grid.Row="1"/>


    </Grid>
</Window>
