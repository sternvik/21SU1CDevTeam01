<Window x:Class="Presentationslager.Personal.Rapporter.RapporterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager.Personal.Rapporter"
        xmlns:vm="clr-namespace:Presentationslager.ViewModels"
        mc:Ignorable="d"
        Title="RapporterWindow" Height="450" Width="800"
        Background="#6ab">

    <Window.DataContext>
        <vm:RapporterViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Rapporter" FontSize="25" FontWeight="Bold" TextAlignment="Center"/>
            <Button Content="Utrustningsrapport" Height="25" Width="200" Command="{Binding ÖppnaUtrustningRapportCommand}"/>
            <Button Content="Träningspassrapport" Height="25" Width="200" Command="{Binding ÖppnaTräningspassRapportCommand}"/>
            <Button Content="Tillbaka" Height="25" Width="200" Command="{Binding TillbakaCommand}"/>
        </StackPanel>
    </Grid>
</Window>
