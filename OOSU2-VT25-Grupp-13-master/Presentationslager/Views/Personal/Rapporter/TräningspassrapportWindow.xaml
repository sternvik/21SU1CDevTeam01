<Window x:Class="Presentationslager.Personal.Rapporter.TräningspassrapportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager.Personal.Rapporter"
        xmlns:vm="clr-namespace:Presentationslager.ViewModels"
        mc:Ignorable="d"
        Title="TräningspassrapportWindow" Height="450" Width="800"
        Background="#6ab">

    <Window.DataContext>
        <vm:TräningspassRapportViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!--Titel-->
        <TextBlock Text="Träningspassrapport" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Aktivitets filter:" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                <ComboBox Height="25" Width="200" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ItemsSource="{Binding Specialiseringar}" SelectedItem="{Binding ValdSpecialisering, Mode=TwoWay}"/>

                <TextBlock Text="Tillgängliga träningspass:" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <DataGrid Width="400" Height="200" VerticalAlignment="Center" HorizontalAlignment="Center" ItemsSource="{Binding TräningspassLista}" SelectedItem="{Binding ValdTräningspass, Mode=TwoWay}"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Deltagare för valt pass:" FontWeight = "Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,60,0,0"/>
                <ListBox Height="200" Width="300" VerticalAlignment="Center" HorizontalAlignment="Center" ItemsSource="{Binding Deltagare}" SelectedItem="{Binding ValdDeltagare}"
                 DisplayMemberPath="Namn"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                <TextBlock Text="Tränare:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding TränareFörPass.Namn, Mode=OneWay}" VerticalAlignment="Center" Height="25" Width="200" IsReadOnly="True"/>

                <TextBlock Text="Datum:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Datum, Mode=OneWay}" VerticalAlignment="Center" Height="25" Width="200" IsReadOnly="True"/>
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <TextBlock Text="Tid:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding ValdTräningspass.Tid, Mode=OneWay}" VerticalAlignment="Center" Height="25" Width="200" IsReadOnly="True"/>

                <TextBlock Text="Plats:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding ValdTräningspass.Plats}" VerticalAlignment="Center" Height="25" Width="200" IsReadOnly="True"/>
            </StackPanel>
            
            <Button Content="Tillbaka" Height="25" Width="200" Command="{Binding TillbakaCommand}" Grid.Column="3"/>
        </Grid>
    </Grid>
</Window>
