<Window x:Class="Presentationslager.Personal.Rapporter.UtrustningsrapportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager.Personal.Rapporter"
        xmlns:vm="clr-namespace:Presentationslager.ViewModels"
        mc:Ignorable="d"
        Title="UtrustningsrapportWindow" Height="450" Width="800"
        Background="#6ab">

    <Window.DataContext>
        <vm:UtrustningRapportViewModel/>
    </Window.DataContext>

    <Grid Margin="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!--Titel-->
        <TextBlock Text="Utrustningsrapport" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Trasig Utrustning:" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ListBox ItemsSource="{Binding TrasigUtrustning}" DisplayMemberPath="Namn" Height="200" Width="200" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Saknad Utrustning:" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ListBox  ItemsSource="{Binding SaknadUtrustning}" DisplayMemberPath="Namn" Height="200" Width="200" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
        
        <Button Content="Tillbaka" Height="25" Width="200" Command="{Binding TillbakaCommand}" Grid.Row="2"/>
    </Grid>
</Window>
