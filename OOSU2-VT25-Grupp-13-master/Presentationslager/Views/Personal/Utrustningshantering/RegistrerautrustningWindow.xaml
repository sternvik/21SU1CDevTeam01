<Window x:Class="Presentationslager.Personal.Utrustningshantering.RegistrerautrustningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager.Personal.Utrustningshantering"
        xmlns:vm="clr-namespace:Presentationslager.ViewModels"
        mc:Ignorable="d"
        Title="Registrera Utrustning" Height="450" Width="800"
        Background="#6ab">

    <Window.DataContext>
        <!-- Lägg till ViewModeln -->
        <vm:RegistreraUtrustningViewModel />
    </Window.DataContext>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
        <TextBlock Text="Registrera utrustning" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Namn:" Width="100" VerticalAlignment="Center"/>
            <TextBox Width="200" Height="25" Text="{Binding Namn}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Kategori:" Width="100" VerticalAlignment="Center"/>
            <ComboBox Width="200" Height="25" SelectedItem="{Binding Kategori}" ItemsSource="{Binding KategoriList}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Skick:" Width="100" VerticalAlignment="Center"/>
            <ComboBox Width="200" Height="25" SelectedItem="{Binding Skick}" ItemsSource="{Binding SkickList}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Tillgängliga:" Width="100" VerticalAlignment="Center"/>
            <TextBox Width="200" Height="25" Text="{Binding Tillgängliga}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Registrera" Width="100" Height="30" Margin="10,0,10,0" Command="{Binding RegistreraUtrustningCommand}"/>
            <Button Content="Tillbaka" Width="100" Height="30" Command="{Binding TillbakaCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
