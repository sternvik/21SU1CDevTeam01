<Window x:Class="Presentationslager.Personal.Utrustningshantering.TabortutrustningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager.Personal.Utrustningshantering"
        xmlns:vm="clr-namespace:Presentationslager.ViewModels"
        mc:Ignorable="d"
        Title="Ta bort utrustning" Height="500" Width="800"
        Background="#6ab">

    <Window.DataContext>
        <vm:TaBortUtrustningViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10">
            <TextBlock Text="Ta bort utrustning" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Kategorifilter:" Width="150" VerticalAlignment="Center" FontWeight="Bold"/>
                <ComboBox ItemsSource="{Binding Kategorier}" Width="200" Height="25" SelectedItem="{Binding ValdKategori, Mode=TwoWay}"/>
            </StackPanel>

            <TextBlock Text="Tillgänglig utrustning:" FontWeight="Bold" Margin="0,10,0,0"/>
            <DataGrid ItemsSource="{Binding UtrustningLista}" Width="500" Height="200"  SelectedItem="{Binding ValdUtrustning, Mode=TwoWay}"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Vald Utrustning:" Width="150" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox Text="{Binding ValdUtrustning.Namn}" IsReadOnly="True" Width="200" Height="25"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,10,0,10">
            <Button Content="Ta bort" Width="100" Height="30" Margin="10,0,10,0" Command="{Binding TaBortUtrustningCommand}"/>
            <Button Content="Tillbaka" Width="100" Height="30" Command="{Binding TillbakaCommand}"/>
        </StackPanel>
    </Grid>
</Window>
