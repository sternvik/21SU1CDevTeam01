<Window x:Class="Presentationslager.Personal.Tränarhantering.TränarhanteringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager.Personal.Tränarhantering"
        xmlns:vm="clr-namespace:Presentationslager.ViewModels"
        mc:Ignorable="d"
        Title="TränarhanteringWindow" Height="450" Width="800"
        Background="#6ab">

    <Window.DataContext>
        <vm:TränarhanteringViewModel />
    </Window.DataContext>


    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Tränarshantering" FontSize="24" FontWeight="Bold" />
            <Button Content="Lägg till tränare" Height="25" Width="200" Command="{Binding LäggTillTränareCommand}"/>
            <Button Content="Uppdatera tränare" Height="25" Width="200" Command="{Binding UppdateraTränareCommand}"/>
            <Button Content="Ta bort tränare" Height="25" Width="200" Command="{Binding TaBortTränareCommand}"/>
            <Button Content="Visa alla tränare" Height="25" Width="200" Command="{Binding VisaAllaTränareCommand}"/>
            <Button Content="Tillbaka" Height="25" Width="200" Command="{Binding TillbakaCommand}"/>
        </StackPanel>
    </Grid>
</Window>