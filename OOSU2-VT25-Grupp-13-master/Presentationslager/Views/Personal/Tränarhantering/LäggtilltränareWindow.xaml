<Window x:Class="Presentationslager.Personal.Tränarhantering.LäggtilltränareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager.Personal.Tränarhantering"
        xmlns:Services="clr-namespace:Presentationslager.Services"
        xmlns:vm="clr-namespace:Presentationslager.ViewModels"
        mc:Ignorable="d"
        Title="LäggtilltränareWindow" Height="450" Width="800"
        Background="#6ab">

    <Window.DataContext>
        <vm:LäggTillTränareViewModel />
    </Window.DataContext>

    <Grid>
        <TextBlock Text="Lägg till tränare" FontSize="25" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,30,0,0"/>

        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                <TextBlock Text="Namn:" VerticalAlignment="Center" Width="150"/>
                <TextBox Text="{Binding Namn, Mode=TwoWay}" Height="25" Width="200" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                <TextBlock Text="Specialisering:" VerticalAlignment="Center" Width="150"/>
                <ComboBox Width="200" Height="25" 
                          ItemsSource="{Binding Specialiseringar}" 
                          SelectedItem="{Binding Specialisering, Mode=TwoWay}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                <TextBlock Text="Lösenord:" VerticalAlignment="Center" Width="150"/>
                <PasswordBox Height="25" Services:LösenordService.Password="{Binding Lösenord, Mode=TwoWay}" Width="200"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                <TextBlock Text="Bekräfta Lösenord:" VerticalAlignment="Center" Width="150"/>
                <PasswordBox Height="25" Services:LösenordService.Password="{Binding BekräftaLösenord, Mode=TwoWay}" Width="200"/>
            </StackPanel>

            <Button Content="Lägg till tränare" Height="25" Width="200" HorizontalAlignment="Center" Margin="0,20" Command="{Binding LäggTillTränareCommand}"/>
            <Button Content="Tillbaka" Height="25" Width="200" HorizontalAlignment="Center" Margin="0,10" Command="{Binding TillbakaCommand}"/>
        </StackPanel>
    </Grid>
</Window>
