<Window x:Class="Presentationslager.Personal.Tränarhantering.VisaAllaTränareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager.Personal.Tränarhantering"
        xmlns:vm="clr-namespace:Presentationslager.ViewModels"
        mc:Ignorable="d"
        Title="Visa Alla Tränare" Height="500" Width="800"
        Background="#6ab">

    <Window.DataContext>
        <!-- Bind ViewModel som DataContext -->
        <vm:VisaAllaTränareViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10">
            <TextBlock Text="Visa Alla Tränare" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Specialisering:" Width="150" VerticalAlignment="Center" FontWeight="Bold"/>
                <ComboBox ItemsSource="{Binding Specialiseringar}"
                          SelectedItem="{Binding ValdSpecialisering, Mode=TwoWay}"
                          Height="25" Width="200"
                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Tränare:" FontWeight="Bold" Margin="0,10,0,0"/>
            <DataGrid x:Name="TränareDataGrid" Width="500" Height="200" ItemsSource="{Binding Tränare}"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Tillbaka" Width="100" Height="30" Command="{Binding TillbakaCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
