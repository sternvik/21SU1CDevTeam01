<Window x:Class="Presentationslager.Personal.Medlemshantering.TabortmedlemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager.Personal.Medlemshantering"
        xmlns:vm="clr-namespace:Presentationslager.ViewModels"
        mc:Ignorable="d"
        Title="TabortmedlemWindow" Height="450" Width="800"
        Background="#6ab">
    
    <Window.DataContext>
        <vm:UppdateraMedlemViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="9*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Ta bort medlem" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Tillgängliga medlemmar:" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"/>
            <DataGrid ItemsSource="{Binding Medlemmar}" SelectedItem="{Binding ValdMedlem, Mode=TwoWay}" 
                      Width="700" Height="240" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <TextBlock Text="Vald medlem:" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBox Text="{Binding ValdMedlem.Namn}" IsReadOnly="True" Height="25" Width="200" VerticalContentAlignment="Center" HorizontalAlignment="Center"/>
        </StackPanel>
            
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Grid.Row="1" Orientation="Horizontal">
            <Button Content="Ta bort" Width="200" Height="25" Command="{Binding TaBortMedlemCommand}" Margin="0,0,50,0"/>
            <Button Content="Tillbaka" Width="200" Height="25" Command="{Binding TillbakaCommand}"/>
        </StackPanel>
    </Grid>
</Window>
