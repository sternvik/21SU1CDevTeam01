<Window x:Class="Medlemsapplikationen.Views.MittKontoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Medlemsapplikationen.Views"
        xmlns:Services="clr-namespace:Medlemsapplikationen.Services"
        xmlns:vm="clr-namespace:Medlemsapplikationen.ViewModels"
        mc:Ignorable="d"
        Title="MittKontoWindow" Height="450" Width="800">
    <Window.DataContext>
        <vm:MittKontoViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="SlateGray"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="BorderBrush" Value="DarkSlateGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="DarkSlateGray"/>
                    <Setter Property="Foreground" Value="LightGray"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/tennis-7932067_1280.jpg" Stretch="Fill"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="8*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="SlateGray">
            <StackPanel Orientation="Horizontal" Height="50" HorizontalAlignment="Center">
                <Button Content="ÖVERSIKT" Command="{Binding ÖppnaMedlemMenyCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="MEDLEMMAR" Command="{Binding ÖppnaAllaMedlemmarCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="RABATTNIVÅ" Style="{StaticResource MenuButtonStyle}" Command="{Binding ÖppnaRabattNivåCommand}"/>
                <Button Content="KOMMNADE PASS" Command="{Binding ÖppnaKommandePassCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="GENÖMFÖRDA PASS" Command="{Binding ÖppnaGenomfördaPassCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="BOKA TRÄNINGSPASS" Command="{Binding ÖppnaBokaTräninspassCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="MITT KONTO" Command="{Binding ÖppnaMittKontoCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="LOGGA UT" Command="{Binding TillbakaCommand}" Style="{StaticResource MenuButtonStyle}"/>
            </StackPanel>
        </Grid>

        <Border Background="DarkSlateGray" CornerRadius="15" Padding="12"
        Width="450"
        HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1"
        >
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
 

                <StackPanel Margin="4">
                    <TextBlock Text="Namn:" Foreground="White" FontWeight="Bold"/>
                    <TextBox Text="{Binding HämtadMedlem.Namn, UpdateSourceTrigger=PropertyChanged}" Height="25"/>
                </StackPanel>

                <StackPanel Margin="4">
                    <TextBlock Text="Lösenord:" Foreground="White" FontWeight="Bold"/>
                    <PasswordBox Height="25" x:Name="LösenordBox" Services:LösenordService.Password="{Binding HämtadMedlem.Lösenord, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Margin="4">
                    <TextBlock Text=" Bekräfta Lösenord:" Foreground="White" FontWeight="Bold"/>
                    <PasswordBox Height="25" x:Name="BekräftaLösenordBox" Services:LösenordService.Password="{Binding BekräftaLösenord, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Margin="4">
                    <TextBlock Text="Födelsedatum:" Foreground="White" FontWeight="Bold"/>
                    <DatePicker SelectedDate="{Binding HämtadMedlem.Födelse, Mode=TwoWay}" Height="25"/>
                </StackPanel>

                <StackPanel Margin="4">
                    <TextBlock Text="Telefonnummer:" Foreground="White" FontWeight="Bold"/>
                    <TextBox Text="{Binding HämtadMedlem.Telefonnummer, UpdateSourceTrigger=PropertyChanged}" Height="25"/>
                </StackPanel>

                <StackPanel Margin="4">
                    <TextBlock Text="Epost:" Foreground="White" FontWeight="Bold"/>
                    <TextBox Text="{Binding HämtadMedlem.Epost, UpdateSourceTrigger=PropertyChanged}" Height="25"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                    <Button Content="Spara Kontouppgifter" Width="200" Height="25" Command="{Binding UppdateraMedlemCommand}" Margin="0,0,20,0" Style="{StaticResource MenuButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</Window>
