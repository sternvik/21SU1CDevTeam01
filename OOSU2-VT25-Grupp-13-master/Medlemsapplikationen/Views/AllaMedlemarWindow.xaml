<Window x:Class="Medlemsapplikationen.Views.AllaMedlemarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Medlemsapplikationen.Views"
        xmlns:vm="clr-namespace:Medlemsapplikationen.ViewModels"
        mc:Ignorable="d"
        Title="AllaMedlemarWindow" Height="450" Width="800">
    <Window.DataContext>
        <vm:AllaMedlemmarViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="SlateGray"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="BorderBrush" Value="DarkSlateGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="DarkSlateGray"/>
                    <Setter Property="Foreground" Value="LightGray"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/tennis-7932067_1280.jpg" Stretch="Fill"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="8*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="SlateGray">
            <StackPanel Orientation="Horizontal" Height="50" HorizontalAlignment="Center">
                <Button Content="ÖVERSIKT" Command="{Binding ÖppnaMedlemMenyCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="MEDLEMMAR" Command="{Binding ÖppnaAllaMedlemmarCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="RABATTNIVÅ" Style="{StaticResource MenuButtonStyle}" Command="{Binding ÖppnaRabattNivåCommand}"/>
                <Button Content="KOMMNADE PASS" Command="{Binding ÖppnaKommandePassCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="GENÖMFÖRDA PASS" Command="{Binding ÖppnaGenomfördaPassCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="BOKA TRÄNINGSPASS" Command="{Binding ÖppnaBokaTräninspassCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="MITT KONTO" Command="{Binding ÖppnaMittKontoCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="LOGGA UT" Command="{Binding TillbakaCommand}" Style="{StaticResource MenuButtonStyle}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" Background="DarkSlateGray"  CornerRadius="10" Padding="20" Margin="10">
                    <StackPanel VerticalAlignment="Top" Margin="0,0,20,0">
                        <TextBlock Text="Tillgängliga Medlemmar:" FontWeight="Bold" Margin="10,15,0,5" Foreground="White"/>
                        <DataGrid Height="200" ItemsSource="{Binding MedlemmarLista}" SelectedItem="{Binding ValdMedlem, Mode=TwoWay}" Margin="0,5" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding MedlemID}" Width="1*"/>
                                <DataGridTextColumn Header="Namn" Binding="{Binding Namn}" Width="2*"/>
                                <DataGridTextColumn Header="Poäng" Binding="{Binding Poäng}" Width="1*"/>
                                <DataGridTextColumn Header="Kalorier" Binding="{Binding Kalorier}" Width="1*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="DarkSlateGray"  CornerRadius="10" Padding="20" Margin="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.5*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="MedlemsProfil" FontWeight="Bold" Foreground="White" Margin="0,5" Grid.Row="0" Grid.Column="1"/>

                        <TextBlock Text="Namn:" FontWeight="Bold" Foreground="White" Margin="0,5" Grid.Row="1" Grid.Column="0"/>
                        <TextBlock Text="{Binding ValdMedlem.Namn, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="White" Grid.Row="1" Grid.Column="1"/>

                        <TextBlock Text="Kalorier:" FontWeight="Bold" Foreground="White" Margin="0,5" Grid.Row="2" Grid.Column="0"/>
                        <TextBlock Text="{Binding ValdMedlem.Kalorier, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="White" Grid.Row="2" Grid.Column="1"/>

                        <TextBlock Text="Poäng" FontWeight="Bold" Foreground="White" Margin="0,5" Grid.Row="3" Grid.Column="0"/>
                        <TextBlock Text="{Binding ValdMedlem.Poäng, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="White" Grid.Row="3" Grid.Column="1"/>

                        <TextBlock Text="Antal Pass" FontWeight="Bold" Foreground="White" Margin="0,5" Grid.Row="4" Grid.Column="0"/>
                        <TextBlock Text="{Binding AntalTräningspass, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="White" Grid.Row="4" Grid.Column="1"/>

                    </Grid>
                </Border>
            </Grid>
        </Border>

    </Grid>
</Window>
