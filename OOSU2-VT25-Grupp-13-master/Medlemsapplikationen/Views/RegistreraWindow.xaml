<Window x:Class="Medlemsapplikationen.Views.RegistreraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Medlemsapplikationen.Views"
        xmlns:Services="clr-namespace:Medlemsapplikationen.Services"
        xmlns:vm="clr-namespace:Medlemsapplikationen.ViewModels"
        mc:Ignorable="d"
        Title="RegistreraWindow" Height="450" Width="800">
    <Window.DataContext>
        <vm:RegistreraViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="SlateGray"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="BorderBrush" Value="DarkSlateGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="DarkSlateGray"/>
                    <Setter Property="Foreground" Value="LightGray"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Image Source="/Images/tennis-7932067_1280.jpg"
       Stretch="Fill"/>
        <Border Background="SlateGray" CornerRadius="15" Padding="20"
        Width="450" Height="450"
        HorizontalAlignment="Center" VerticalAlignment="Center"
        >
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,5">
                <TextBlock Text="Skapa Konto" FontSize="20" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold"/>

                <StackPanel Margin="5">
                    <TextBlock Text="Namn:" Foreground="White" FontWeight="Bold"/>
                    <TextBox Text="{Binding Namn, UpdateSourceTrigger=PropertyChanged}" Height="25"/>
                </StackPanel>

                <StackPanel Margin="5">
                    <TextBlock Text="Lösenord:" Foreground="White" FontWeight="Bold"/>
                    <PasswordBox Height="25" x:Name="LösenordBox" Services:LösenordService.Password="{Binding Lösenord, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Margin="5">
                    <TextBlock Text=" Bekräfta Lösenord:" Foreground="White" FontWeight="Bold"/>
                    <PasswordBox Height="25" x:Name="BekräftaLösenordBox" Services:LösenordService.Password="{Binding BekräftaLösenord, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Margin="5">
                    <TextBlock Text="Födelsedatum:" Foreground="White" FontWeight="Bold"/>
                    <DatePicker SelectedDate="{Binding Födelsedatum, Mode=TwoWay}" Height="25"/>
                </StackPanel>

                <StackPanel Margin="5">
                    <TextBlock Text="Telefonnummer:" Foreground="White" FontWeight="Bold"/>
                    <TextBox Text="{Binding Telefonnummer, UpdateSourceTrigger=PropertyChanged}" Height="25"/>
                </StackPanel>

                <StackPanel Margin="5">
                    <TextBlock Text="Epost:" Foreground="White" FontWeight="Bold"/>
                    <TextBox Text="{Binding Epost, UpdateSourceTrigger=PropertyChanged}" Height="25"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                    <Button Content="Skapa Konto" Width="120" Command="{Binding LäggTillMedlemCommand}" Margin="0,0,20,0" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="Tillbaka" Width="120" Command="{Binding TillbakaCommand}" Style="{StaticResource MenuButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
