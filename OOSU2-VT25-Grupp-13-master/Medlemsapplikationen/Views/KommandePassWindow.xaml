<Window x:Class="Medlemsapplikationen.Views.KommandePassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Medlemsapplikationen.Views"
        xmlns:vm="clr-namespace:Medlemsapplikationen.ViewModels"
        mc:Ignorable="d"
        Title="KommandePassWindow" Height="450" Width="800">

    <Window.DataContext>
        <vm:KommandePassViewmodel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="SlateGray"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="BorderBrush" Value="DarkSlateGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="DarkSlateGray"/>
                    <Setter Property="Foreground" Value="LightGray"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/tennis-7932067_1280.jpg" Stretch="Fill"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="8*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="SlateGray">
            <StackPanel Orientation="Horizontal" Height="50" HorizontalAlignment="Center">
                <Button Content="ÖVERSIKT" Command="{Binding ÖppnaMedlemMenyCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="MEDLEMMAR" Command="{Binding ÖppnaAllaMedlemmarCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="RABATTNIVÅ" Style="{StaticResource MenuButtonStyle}" Command="{Binding ÖppnaRabattNivåCommand}"/>
                <Button Content="KOMMNADE PASS" Command="{Binding ÖppnaKommandePassCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="GENÖMFÖRDA PASS" Command="{Binding ÖppnaGenomfördaPassCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="BOKA TRÄNINGSPASS" Command="{Binding ÖppnaBokaTräninspassCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="MITT KONTO" Command="{Binding ÖppnaMittKontoCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="LOGGA UT" Command="{Binding TillbakaCommand}" Style="{StaticResource MenuButtonStyle}"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="DarkSlateGray" CornerRadius="10" Padding="20">
            <StackPanel VerticalAlignment="Top" Margin="0,0,20,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Aktivitetsfilter:" FontWeight="Bold" Foreground="White" Margin="5"/>
                    <ComboBox Height="25" ItemsSource="{Binding Specialiseringar}" 
                      SelectedItem="{Binding ValdSpecialisering, Mode=TwoWay}" Width="200"/>
                    <Button Content="Avboka pass" Command="{Binding AvanmälTräningspassCommand}" 
                    Height="25" Width="200" HorizontalAlignment="Center" Margin="80,0,0,0" Style="{StaticResource MenuButtonStyle}"/>
                </StackPanel>

                <TextBlock Text="Kommande träningspass:" FontWeight="Bold" Margin="10,15,0,5" Foreground="White"/>
                <DataGrid Height="200" ItemsSource="{Binding TräningspassLista}" 
                  SelectedItem="{Binding ValdTräningspass, Mode=TwoWay}" Margin="0,5"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
