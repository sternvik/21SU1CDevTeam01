<Window x:Class="Medlemsapplikationen.Views.MedlemMenyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Medlemsapplikationen.Views"
        xmlns:vm="clr-namespace:Medlemsapplikationen.ViewModels"
        mc:Ignorable="d"
        Title="MedlemMenyWindow" Height="450" Width="800">
    <Window.DataContext>
        <vm:MedlemMenyViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="SlateGray"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="BorderBrush" Value="DarkSlateGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="DarkSlateGray"/>
                    <Setter Property="Foreground" Value="LightGray"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/tennis-7932067_1280.jpg" Stretch="Fill"/>
        </Grid.Background>

        <!-- Definiera rader -->
        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*"/>
            <!-- Meny -->
            <RowDefinition Height="2*"/>
            <!-- Profil -->
            <RowDefinition Height="6*"/>
            <!-- Statistik -->
        </Grid.RowDefinitions>

        <!-- Toppmeny -->
        <Grid Grid.Row="0" Background="SlateGray">
            <StackPanel Orientation="Horizontal" Height="50" HorizontalAlignment="Center">
                <Button Content="ÖVERSIKT" Command="{Binding ÖppnaMedlemMenyCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="MEDLEMMAR" Command="{Binding ÖppnaAllaMedlemmarCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="RABATTNIVÅ" Style="{StaticResource MenuButtonStyle}" Command="{Binding ÖppnaRabattNivåCommand}"/>
                <Button Content="KOMMNADE PASS" Command="{Binding ÖppnaKommandePassCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="GENÖMFÖRDA PASS" Command="{Binding ÖppnaGenomfördaPassCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="BOKA TRÄNINGSPASS" Command="{Binding ÖppnaBokaTräninspassCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="MITT KONTO" Command="{Binding ÖppnaMittKontoCommand}" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="LOGGA UT" Command="{Binding TillbakaCommand}" Style="{StaticResource MenuButtonStyle}"/>
            </StackPanel>
        </Grid>
        <!-- Profilsektion -->
        <Grid Grid.Row="1" Background="DarkSlateGray">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Hej " Foreground="White" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="{Binding HämtadMedlem.Namn}" Foreground="White" FontSize="24" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <!-- Statistiksektion -->
        <Grid Grid.Row="2" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Background="SlateGray" CornerRadius="10" Padding="20" Margin="10">
                <StackPanel>
                    <TextBlock Text="KALORIER" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Totalt antal brända kalorier" Foreground="White"/>
                    <TextBlock Text="{Binding HämtadMedlem.Kalorier, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="SlateGray" CornerRadius="10" Padding="20" Margin="10">
                <StackPanel>
                    <TextBlock Text="POÄNG" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Totalt antal poäng" Foreground="White"/>
                    <TextBlock Text="{Binding HämtadMedlem.Poäng, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="SlateGray" CornerRadius="10" Padding="20" Margin="10">
                <StackPanel>
                    <TextBlock Text="TOTALA TRÄNINGSPASS" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Träningsstatistik" Foreground="White"/>
                    <TextBlock Text="{Binding AntalTräningspass, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
