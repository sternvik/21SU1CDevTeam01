<Window x:Class="PresentationsLager.Views.BestallningsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PresentationsLager.ViewModels"
        Title="RestoNation - Beställningar"
        WindowState="Maximized">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F7F4EF" Offset="0"/>
            <GradientStop Color="#A3B18A" Offset="0.3"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.DataContext>
        <vm:BestallningsWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Boolean to Visibility Converter -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Standard knapp-stil -->
        <Style x:Key="StandardButton" TargetType="Button">
            <Setter Property="Background" Value="#102c48"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F4B942"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Stor knapp för val av typ -->
        <Style x:Key="LargeTypeButton" TargetType="Button">
            <Setter Property="Background" Value="#102c48"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="30,20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F4B942"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#102c48" CornerRadius="5" Padding="15" Margin="0,0,0,20">
            <TextBlock Text="🍽️ BESTÄLLNINGAR - LUNCH &amp; AVHÄMTNING"
                       FontSize="24" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- Steg 1: Välj beställningstyp -->
            <StackPanel Visibility="{Binding VisaTypVal, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- Kundinformation -->
                <Border Background="#E8F5E9" CornerRadius="10" Padding="20" Margin="0,0,0,30"
                        BorderBrush="#2E7D32" BorderThickness="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,30,0">
                            <TextBlock Text="👤 VALD KUND" FontSize="20" FontWeight="Bold"
                                       Foreground="#2E7D32" Margin="0,0,0,10"/>
                            <TextBlock FontSize="16">
                                <Run Text="Namn: " FontWeight="Bold"/>
                                <Run Text="{Binding ValdKund.Namn}"/>
                            </TextBlock>
                            <TextBlock FontSize="16">
                                <Run Text="Telefon: " FontWeight="Bold"/>
                                <Run Text="{Binding ValdKund.Telefon}"/>
                            </TextBlock>
                            <TextBlock FontSize="16">
                                <Run Text="Email: " FontWeight="Bold"/>
                                <Run Text="{Binding ValdKund.Email}"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="🏆 LOJALITETSPROGRAM" FontSize="18" FontWeight="Bold"
                                       Foreground="#2E7D32" Margin="0,0,0,10"/>
                            <TextBlock FontSize="28" FontWeight="Bold" Foreground="#2E7D32"
                                       HorizontalAlignment="Center">
                                <Run Text="{Binding ValdKund.LojalitetsNiva}"/>
                                <Run Text=" - "/>
                                <Run Text="{Binding ValdKund.LojalitetsPoang}"/>
                                <Run Text=" poäng"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Beställningstyp -->
                <TextBlock Text="Välj beställningstyp:" FontSize="18" FontWeight="Bold"
                           Foreground="#102c48" Margin="0,0,0,30" HorizontalAlignment="Center"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="🍽️ LUNCH"
                            Command="{Binding ValjLunchCommand}"
                            Style="{StaticResource LargeTypeButton}"
                            Height="200"/>

                    <Button Grid.Column="2" Content="📦 AVHÄMTNING"
                            Command="{Binding ValjAvhamtningCommand}"
                            Style="{StaticResource LargeTypeButton}"
                            Height="200"/>
                </Grid>

                <Button Content="⬅️ TILLBAKA" Command="{Binding TillbakaTillKundsokningCommand}"
                        Style="{StaticResource StandardButton}"
                        Width="150" HorizontalAlignment="Center" Margin="0,40,0,0"/>

                <Button Content="Välj kund för beställning" Command="{Binding TillKundSokCommand}"
                        Style="{StaticResource StandardButton}"
                        Width="250" HorizontalAlignment="Center" Margin="0,40,0,0"/> 
            </StackPanel>

            <!-- Steg 3: Beställningsvy (Lunch eller Avhämtning) -->
            <Grid Visibility="{Binding VisaBestallning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Vänster: Meny -->
                <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20"
                        BorderBrush="#102c48" BorderThickness="2">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="Bold" Margin="0,0,0,15">
                            <Run Text="📋 MENY - "/>
                            <Run Text="{Binding ValdBestallningsTyp}"/>
                        </TextBlock>

                        <!-- Avhämtning: Visa utkörare -->
                        <StackPanel Visibility="{Binding VisaUtkorare, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="0,0,0,15">
                            <TextBlock Text="Välj utkörare:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding Utkorare}"
                                      SelectedItem="{Binding ValdUtkorare}"
                                      FontSize="14" Padding="8" Height="35"/>
                        </StackPanel>

                        <!-- Menyfilter för avhämtning -->
                        <StackPanel Visibility="{Binding VisaMenyfilter, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="0,0,0,15">
                            <TextBlock Text="Kategori:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding MenyKategorier}"
                                      SelectedItem="{Binding ValdMenyKategori}"
                                      FontSize="14" Padding="8" Height="35"/>
                        </StackPanel>

                        <!-- Menylista -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="480">
                            <ItemsControl ItemsSource="{Binding FiltrerdeMenyvaror}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                                                Padding="10" Margin="0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Rattnamn}"
                                                               FontSize="15" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Beskrivning}"
                                                               FontSize="12" Foreground="#666"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock FontSize="12" Foreground="#999">
                                                        <Run Text="Kategori: "/>
                                                        <Run Text="{Binding Kategori}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Pris, StringFormat='{}{0:F0} kr'}"
                                                           FontSize="16" FontWeight="Bold"
                                                           Foreground="#102c48"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,15,0"/>

                                                <Button Grid.Column="2" Content="+"
                                                        Command="{Binding DataContext.LaggTillIMenyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#27AE60" Foreground="White"
                                                        FontSize="20" FontWeight="Bold"
                                                        Width="40" Height="40"
                                                        Cursor="Hand" BorderThickness="0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="20">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Höger: Varukorg och betalning -->
                <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="20"
                        BorderBrush="#102c48" BorderThickness="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Rubrik -->
                        <TextBlock Grid.Row="0" Text="🛒 VARUKORG"
                                   FontSize="18" FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <!-- Beställningsrader -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Bestallning}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                                                Padding="5" Margin="0,5">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Text="{Binding Rattnamn}"
                                                           FontSize="14" FontWeight="Bold"/>

                                                <Grid Grid.Row="1" Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <Button Content="-"
                                                                Command="{Binding DataContext.TaBortFranBestallningCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Background="#E74C3C" Foreground="White"
                                                                Width="25" Height="25" FontWeight="Bold"
                                                                Cursor="Hand" BorderThickness="0"/>
                                                        <TextBlock Text="{Binding Antal}"
                                                                   FontSize="14" FontWeight="Bold"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Totalpris, StringFormat='{}{0:F0} kr'}"
                                                               FontSize="14" FontWeight="Bold"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Totalsumma och knappar -->
                        <StackPanel Grid.Row="2">
                            <Border Background="#F7F4EF" CornerRadius="5"
                                    Padding="10" Margin="0,15,0,15">
                                <TextBlock FontSize="18" FontWeight="Bold"
                                           Foreground="#102c48" TextAlignment="Right">
                                    <Run Text="TOTALT: "/>
                                    <Run Text="{Binding Totalpris, StringFormat='{}{0:F0} kr'}"/>
                                </TextBlock>
                            </Border>

                            <Button Content="💳 BETALA" Command="{Binding BetalaCommand}"
                                    Background="#27AE60" Foreground="White"
                                    FontSize="16" FontWeight="Bold"
                                    Height="50" Margin="0,0,0,10"
                                    Cursor="Hand" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Content="⬅️ TILLBAKA"
                                    Command="{Binding TillbakaTillTypValCommand}"
                                    Style="{StaticResource StandardButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
