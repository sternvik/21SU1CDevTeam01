<Window x:Class="PresentationsLager.Views.BokningsHanteringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PresentationsLager.ViewModels"
        mc:Ignorable="d"
        Title="RestoNation - Hantera Bokningar"
        WindowState="Maximized"
        
        ResizeMode="CanResize">

    <Window.DataContext>
        <vm:BokningsHanteringWindowViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F7F4EF" Offset="0"/>
                <GradientStop Color="#A3B18A" Offset="0.3"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#102c48">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="RestoNation"
                               FontFamily="Montserrat"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,30,0"/>
                    <TextBlock Text="HANTERA BOKNINGAR"
                               FontFamily="Inter"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#F4B942"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- User Info -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding InloggadAnvandare.Namn}"
                               FontFamily="Inter"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>
                    <Button Content="STÄNG"
                            Command="{Binding StängCommand}"
                            Height="35"
                            FontFamily="Inter"
                            FontSize="12"
                            FontWeight="Bold"
                            Background="#A3B18A"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="15,0"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Date/Time Controls -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#102c48"
                    BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect Color="Gray" Direction="315" ShadowDepth="5" Opacity="0.3"/>
                </Border.Effect>

                <StackPanel Margin="20">
                    <!-- Header -->
                    <TextBlock Text="📅 VÄLJ DATUM &amp; TID"
                               FontFamily="Montserrat"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#102c48"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Date Picker -->
                    <TextBlock Text="DATUM:"
                               FontFamily="Inter"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#102c48"
                               Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding ValtDatum, UpdateSourceTrigger=PropertyChanged}"
                                Height="35"
                                FontFamily="Inter"
                                FontSize="14"
                                BorderBrush="#102c48"
                                BorderThickness="1"
                                Margin="0,0,0,20"/>

                    <!-- Time Picker -->
                    <TextBlock Text="TID:"
                               FontFamily="Inter"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#102c48"
                               Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding TillgangligaTider}"
                              SelectedItem="{Binding ValdTid, UpdateSourceTrigger=PropertyChanged}"
                              Height="35"
                              FontFamily="Inter"
                              FontSize="14"
                              BorderBrush="#102c48"
                              BorderThickness="1"
                              Margin="0,0,0,20"/>

                    <!-- Guests Counter -->
                    <TextBlock Text="ANTAL GÄSTER:"
                               FontFamily="Inter"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#102c48"
                               Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Button Content="-"
                                Command="{Binding MinskaGästerCommand}"
                                Width="30"
                                Height="30"
                                FontSize="16"
                                FontWeight="Bold"
                                Background="#A3B18A"
                                Foreground="White"
                                BorderThickness="0"/>
                        <TextBox Text="{Binding AntalGäster, UpdateSourceTrigger=PropertyChanged}"
                                 Width="40"
                                 Height="30"
                                 FontFamily="Inter"
                                 FontSize="14"
                                 TextAlignment="Center"
                                 BorderBrush="#102c48"
                                 BorderThickness="1"
                                 Margin="5,0"/>
                        <Button Content="+"
                                Command="{Binding ÖkaGästerCommand}"
                                Width="30"
                                Height="30"
                                FontSize="16"
                                FontWeight="Bold"
                                Background="#A3B18A"
                                Foreground="White"
                                BorderThickness="0"/>
                    </StackPanel>

                    <!-- Update Button -->
                    <Button Content="UPPDATERA VY"
                            Command="{Binding UppdateraVyCommand}"
                            Height="40"
                            FontFamily="Inter"
                            FontSize="12"
                            FontWeight="Bold"
                            Background="#F4B942"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,0,20"/>

                    <!-- Legend -->
                    <Border BorderBrush="#102c48"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10"
                            Background="#F7F4EF">
                        <StackPanel>
                            <TextBlock Text="FÄRGKOD:"
                                       FontFamily="Inter"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#102c48"
                                       Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <Rectangle Width="15" Height="15" Fill="Green" Margin="0,0,5,0"/>
                                <TextBlock Text="Ledigt" FontFamily="Inter" FontSize="10" Foreground="#2E2E2E"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <Rectangle Width="15" Height="15" Fill="Red" Margin="0,0,5,0"/>
                                <TextBlock Text="Bokat" FontFamily="Inter" FontSize="10" Foreground="#2E2E2E"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <Rectangle Width="15" Height="15" Fill="Blue" Margin="0,0,5,0"/>
                                <TextBlock Text="På plats" FontFamily="Inter" FontSize="10" Foreground="#2E2E2E"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="15" Height="15" Fill="Orange" Margin="0,0,5,0"/>
                                <TextBlock Text="För få platser" FontFamily="Inter" FontSize="10" Foreground="#2E2E2E"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Right Panel - Table Overview -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#102c48"
                    BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect Color="Gray" Direction="315" ShadowDepth="5" Opacity="0.3"/>
                </Border.Effect>

                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <TextBlock Text="🍽️ BORDÖVERSIKT - "
                                   FontFamily="Montserrat"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#102c48"/>
                        <TextBlock Text="{Binding ValtDatum, StringFormat='dd/MM/yyyy'}"
                                   FontFamily="Montserrat"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#F4B942"/>
                        <TextBlock Text=" - "
                                   FontFamily="Montserrat"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#102c48"/>
                        <TextBlock Text="{Binding ValdTid, StringFormat='hh\\:mm'}"
                                   FontFamily="Montserrat"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#F4B942"/>
                    </StackPanel>

                    <!-- Tables Grid -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding BordMedStatus}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.BordClickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Width="120"
                                            Height="80"
                                            Margin="5"
                                            Cursor="Hand"
                                            BorderThickness="2"
                                            BorderBrush="#102c48">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Green"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BordStatus}" Value="Bokat">
                                                        <Setter Property="Background" Value="Red"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BordStatus}" Value="På plats">
                                                        <Setter Property="Background" Value="Blue"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ArLampligt}" Value="False">
                                                        <Setter Property="Background" Value="Orange"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Bordkod}"
                                                       FontFamily="Montserrat"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock FontFamily="Inter"
                                                       FontSize="11"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} platser">
                                                        <Binding Path="AntalPlatser"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Text="{Binding BordStatus}"
                                                       FontFamily="Inter"
                                                       FontSize="9"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#2E2E2E">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="RestoNation Bokningshantering"
                           FontFamily="Inter"
                           FontSize="12"
                           Foreground="White"
                           Margin="0,0,20,0"/>
                <TextBlock Text="•"
                           FontSize="12"
                           Foreground="#F4B942"
                           Margin="0,0,20,0"/>
                <TextBlock Text="Klicka på bord för detaljer och check-in/out"
                           FontFamily="Inter"
                           FontSize="12"
                           Foreground="#A3B18A"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
