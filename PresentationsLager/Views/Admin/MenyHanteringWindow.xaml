<Window x:Class="PresentationsLager.Views.Admin.MenyHanteringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PresentationsLager.ViewModels.Admin"
        xmlns:conv="clr-namespace:PresentationsLager.Converters"
        mc:Ignorable="d"
        Title="RestoNation - Menyhantering"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.DataContext>
        <vm:MenyHanteringWindowViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F7F4EF" Offset="0"/>
                <GradientStop Color="#A3B18A" Offset="0.3"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#102c48">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="RestoNation"
                               FontFamily="Montserrat"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,30,0"/>
                    <TextBlock Text="MENYHANTERING"
                               FontFamily="Inter"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#F4B942"/>
                </StackPanel>

                <Button Grid.Column="1" Content="TILLBAKA"
                        Command="{Binding TillbakaCommand}"
                        Height="35"
                        FontFamily="Inter"
                        FontSize="12"
                        FontWeight="Bold"
                        Background="#A3B18A"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="15,0"
                        Cursor="Hand"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Vänsterpanel -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#102c48" BorderThickness="1" Margin="0,0,20,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="30">

                        <TextBlock Text="VÄLJ PLATS" FontFamily="Montserrat" FontSize="20" FontWeight="Bold" Foreground="#102c48" Margin="0,0,0,20"/>

                        <TextBlock Text="Region:"/>
                        <ComboBox ItemsSource="{Binding Regioner}"
                                  SelectedItem="{Binding ValdRegion}"
                                  DisplayMemberPath="Regionnamn"
                                  SelectedValuePath="RegionID"
                                  Height="35" Margin="0,0,0,10"/>

                        <TextBlock Text="Restaurang:"/>
                        <ComboBox ItemsSource="{Binding Restauranger}"
                                  SelectedItem="{Binding ValdRestaurang}"
                                  DisplayMemberPath="Restaurangnamn"
                                  SelectedValuePath="RestaurangID"
                                  Height="35" Margin="0,0,0,15"/>

                        <Rectangle Height="2" Fill="#A3B18A" Margin="0,0,0,30"/>

                        <TextBlock Text="SÖK RÄTT" FontFamily="Montserrat" FontSize="20" FontWeight="Bold" Foreground="#102c48" Margin="0,0,0,20"/>
                        <TextBlock Text="Rättnamn:"/>
                        <TextBox Text="{Binding SokRattnamn, UpdateSourceTrigger=PropertyChanged}" Height="35" Margin="0,0,0,15"/>
                        <TextBlock Text="Kategori:"/>
                        <ComboBox ItemsSource="{Binding Kategorier}"
                                  SelectedItem="{Binding SokKategori}"
                                  Height="35" Margin="0,0,0,15"/>
                        <Button Content="SÖK" Command="{Binding SokMenyCommand}" Height="40" Background="#588157" Foreground="White" BorderThickness="0" Margin="0,0,0,30"/>

                        <Rectangle Height="2" Fill="#A3B18A" Margin="0,0,0,30"/>

                        <TextBlock Text="LÄGG TILL NY RÄTT" FontFamily="Montserrat" FontSize="20" FontWeight="Bold" Foreground="#102c48" Margin="0,0,0,20"/>
                        <TextBlock Text="Rättnamn: *"/>
                        <TextBox Text="{Binding NyRattnamn, UpdateSourceTrigger=PropertyChanged}" Height="35" Margin="0,0,0,10"/>
                        <TextBlock Text="Beskrivning:"/>
                        <TextBox Text="{Binding NyBeskrivning, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>
                        <TextBlock Text="Pris (kr): *"/>
                        <TextBox Text="{Binding NyPrisText, UpdateSourceTrigger=PropertyChanged}" Height="35" Margin="0,0,0,10"/>
                        <TextBlock Text="Kategori: *"/>
                        <ComboBox ItemsSource="{Binding Kategorier}"
                                  SelectedItem="{Binding NyKategori}"
                                  Height="35" Margin="0,0,0,20"/>
                        <Button Content="LÄGG TILL RÄTT" Command="{Binding SkapaMenyCommand}" Height="45" Background="#A3B18A" Foreground="White" BorderThickness="0"/>
                        <TextBlock Text="{Binding NyStatusMessage}" Foreground="Red" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Högerpanel -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" BorderBrush="#102c48" BorderThickness="1">
                <Grid Margin="30" Visibility="{Binding ValdRestaurang, Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding ValdRestaurang.Restaurangnamn, StringFormat='MENY FÖR {0}'}"
                               FontFamily="Montserrat"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#102c48"
                               Margin="0,0,0,15"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Menyvaror}"
                              SelectedItem="{Binding ValdMeny}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              FontFamily="Inter"
                              FontSize="12"
                              Margin="0,0,0,20">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rättnamn" Binding="{Binding Rattnamn}" Width="*"/>
                            <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="200"/>
                            <DataGridTextColumn Header="Pris (kr)" Binding="{Binding Pris}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Visibility="{Binding ValdMeny, Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                        <TextBlock Text="REDIGERA RÄTT" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="Rättnamn:"/>
                        <TextBox Text="{Binding ValdMeny.Rattnamn}" Height="30" Margin="0,0,0,5"/>
                        <TextBlock Text="Beskrivning:"/>
                        <TextBox Text="{Binding ValdMeny.Beskrivning}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,5"/>
                        <TextBlock Text="Pris (kr):"/>
                        <TextBox Text="{Binding ValdMenyPrisText}" Height="30" Margin="0,0,0,5"/>
                        <TextBlock Text="Kategori:"/>
                        <ComboBox ItemsSource="{Binding Kategorier}"
                                  SelectedItem="{Binding ValdMeny.Kategori}"
                                  Height="30" Margin="0,0,0,15"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="SPARA ÄNDRINGAR" Command="{Binding SparaMenyCommand}" Height="35" Background="#588157" Foreground="White" Margin="0,0,10,0"/>
                            <Button Content="TA BORT RÄTT" Command="{Binding TaBortMenyCommand}" Height="35" Background="#E53935" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="Red" Margin="0,15,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#2E2E2E">
            <TextBlock Text="Menyhantering - Hantera, sök och skapa nya rätter"
                       FontFamily="Inter"
                       FontSize="12"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
