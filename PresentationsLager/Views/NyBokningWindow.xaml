<Window x:Class="PresentationsLager.Views.NyBokningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PresentationsLager.ViewModels"
        xmlns:conv="clr-namespace:PresentationsLager.Converters"
        mc:Ignorable="d"
        Title="RestoNation - Ny Bokning"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.DataContext>
        <vm:NyBokningWindowViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F7F4EF" Offset="0"/>
                <GradientStop Color="#A3B18A" Offset="0.3"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#102c48">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="RestoNation"
                               FontFamily="Montserrat"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,30,0"/>
                    <TextBlock Text="NY BOKNING"
                               FontFamily="Inter"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#F4B942"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="TILLBAKA"
                            Command="{Binding TillbakaCommand}"
                            Height="35"
                            FontFamily="Inter"
                            FontSize="12"
                            FontWeight="Bold"
                            Background="#A3B18A"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="15,0"
                            Cursor="Hand"
                            Margin="0,0,10,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Booking Form -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#102c48"
                    BorderThickness="1"
                    Margin="0,0,20,0">
                <Border.Effect>
                    <DropShadowEffect Color="Gray" Direction="315" ShadowDepth="5" Opacity="0.3"/>
                </Border.Effect>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="30">
                        <!-- Booking Form Header -->
                        <TextBlock Text="SKAPA NY BOKNING"
                                   FontFamily="Montserrat"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#102c48"
                                   Margin="0,0,0,30"/>

                        <!-- Date Selection -->
                        <TextBlock Text="Datum: *"
                                   FontFamily="Inter"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#102c48"
                                   Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding ValtDatum}"
                                    Height="35"
                                    FontSize="14"
                                    Margin="0,0,0,20"/>

                        <!-- Time Selection -->
                        <TextBlock Text="Tid: *"
                                   FontFamily="Inter"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#102c48"
                                   Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding TillgangligaTider}"
                                  SelectedItem="{Binding ValdTid}"
                                  DisplayMemberPath="DisplayText"
                                  SelectedValuePath="Tid"
                                  Height="35"
                                  FontSize="14"
                                  Padding="10,8"
                                  BorderBrush="#102c48"
                                  BorderThickness="1"
                                  Margin="0,0,0,20"/>

                        <!-- Number of Guests -->
                        <TextBlock Text="Antal gäster: *"
                                   FontFamily="Inter"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#102c48"
                                   Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding AntalGasterOptions}"
                                  SelectedItem="{Binding ValtAntalGaster}"
                                  Height="35"
                                  FontSize="14"
                                  Padding="10,8"
                                  BorderBrush="#102c48"
                                  BorderThickness="1"
                                  Margin="0,0,0,20"/>

                        <!-- Customer Selection Button -->
                        <TextBlock Text="Kund: *"
                                   FontFamily="Inter"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#102c48"
                                   Margin="0,0,0,5"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding ValdKundText}"
                                     IsReadOnly="True"
                                     Height="35"
                                     FontSize="14"
                                     Padding="10,8"
                                     BorderBrush="#102c48"
                                     BorderThickness="1"
                                     Background="#F8F8F8"/>

                            <Button Grid.Column="1"
                                    Content="VÄLJ KUND"
                                    Command="{Binding ValjKundCommand}"
                                    Height="35"
                                    FontFamily="Inter"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Background="#F4B942"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Padding="10,0"
                                    Cursor="Hand"
                                    Margin="5,0,0,0"/>
                        </Grid>

                        <!-- Special Information -->
                        <TextBlock Text="Specialinformation:"
                                   FontFamily="Inter"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#102c48"
                                   Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Specialinformation, UpdateSourceTrigger=PropertyChanged}"
                                 Height="80"
                                 FontSize="14"
                                 Padding="10,8"
                                 BorderBrush="#102c48"
                                 BorderThickness="1"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,30"/>

                        <!-- Create Booking Button -->
                        <Button Content="SKAPA BOKNING"
                                Command="{Binding SkapaBokningCommand}"
                                Height="45"
                                FontFamily="Montserrat"
                                FontSize="14"
                                FontWeight="Bold"
                                Background="#A3B18A"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,0,20"/>

                        <!-- Status Message -->
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontFamily="Inter"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="Red"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Margin="0,15,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Panel - Available Tables -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#102c48"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Gray" Direction="315" ShadowDepth="5" Opacity="0.3"/>
                </Border.Effect>

                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tables Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="LEDIGA BORD"
                                   FontFamily="Montserrat"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#102c48"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AntalLedigaBord, StringFormat=' ({0} lediga)'}"
                                   FontFamily="Inter"
                                   FontSize="14"
                                   Foreground="#A3B18A"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Tables List as Cards -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LedigaBord}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White"
                                            BorderBrush="{Binding IsSelected, Converter={x:Static conv:BoolToBrushConverter.Instance}}"
                                            BorderThickness="3"
                                            CornerRadius="10"
                                            Margin="8"
                                            MinWidth="140"
                                            Height="120"
                                            Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.ValjBordCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>

                                        <Border.Effect>
                                            <DropShadowEffect Color="Gray" Direction="315" ShadowDepth="3" Opacity="0.3"/>
                                        </Border.Effect>

                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Table Icon -->
                                            <TextBlock Text="🪑"
                                                       FontSize="24"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,5,0,5"/>

                                            <!-- Table Code -->
                                            <TextBlock Text="{Binding Bordkod}"
                                                       FontFamily="Inter"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="#102c48"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,2"/>

                                            <!-- Capacity -->
                                            <TextBlock Text="{Binding AntalPlatser, StringFormat={}{0} platser}"
                                                       FontFamily="Inter"
                                                       FontSize="10"
                                                       Foreground="#666"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,2"/>

                                            <!-- Status -->
                                            <Border Background="{Binding StatusColor}"
                                                    CornerRadius="3"
                                                    Padding="5,2"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,2,0,0">
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontFamily="Inter"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#2E2E2E">
            <TextBlock Text="Ny bokning - Välj datum, tid och kund för att se lediga bord"
                       FontFamily="Inter"
                       FontSize="12"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>